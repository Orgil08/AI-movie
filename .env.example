# MONGODB_URI: Connection string for MongoDB Atlas database
MONGODB_URI=""

# AUTH_SECRET: Session secret for user authentication
AUTH_SECRET=""

# WIRE_API_KEY: Live secret API key from Wire.mn dashboard (https://app.wire.mn)
# Never expose this in client-side code!
WIRE_API_KEY=""

# WIRE_WEBHOOK_SECRET: Secret for verifying WirePayment-Signature HMAC webhook headers
WIRE_WEBHOOK_SECRET=""

# NEXT_PUBLIC_APP_URL / APP_URL: Base URL of the application for webhook and redirect endpoints
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional Gemini API key for AI-generated movie synopses and recommendations
GEMINI_API_KEY="MY_GEMINI_API_KEY"
